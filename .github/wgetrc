# wget settings for the nightly recipe job, passed in as WGETRC by
# .github/workflows/nightly.yml.
#
# A job log is capped at about 2MB and wget's default dot progress writes
# one line per 50KB, so mini-librispeech's 1.2GiB of corpus and language
# models produces some 25,000 lines of dots and spends the entire budget
# before the recipe has begun. Two attempts of run 45202289714 were cut
# off 59 bytes apart, both mid-download, which left the only interesting
# part of the log -- what the recipe did -- unreadable.
#
# verbose = off is wget's -nv: it drops the progress output and keeps the
# error messages. quiet = on would drop those too, which would trade one
# unreadable log for another; tests/recipes/test_nightly_logging.py
# forbids it.
#
# This is a setting for Kaldi's download scripts rather than a change to
# them. They are reached through the local/ symlink into the Kaldi tree
# and are not ours to edit.
verbose = off
