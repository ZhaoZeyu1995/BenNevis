[flake8]
# black is the authority on layout; E501 is set above black's 88 because black
# does not split long strings or comments. E203/W503 conflict with black.
max-line-length = 120
extend-ignore = E203, W503

# Legacy exemptions, deliberately narrow and intended to shrink to nothing.
# New code gets the full gate. The remaining entries are over-long docstrings,
# to be rewrapped when each file is next touched for a real reason rather than
# churned now. The bin/topos/* exemption is gone: those scripts have been
# replaced by the declarative topology specs, which need no exemption.
per-file-ignores =
    BenNevis/bin/align.py:E501
    BenNevis/core/dataset.py:E501
    BenNevis/models/transformer.py:E501
    BenNevis/run/predict.py:E501
